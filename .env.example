# Supabase project (Settings -> API). The anon key is public by design; RLS protects data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: raster tile URL template (default: OpenStreetMap). Respect the provider's usage policy.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional: comma-separated TURN/STUN servers for voice chat (default: public Google STUN)
VITE_ICE_SERVERS=stun:stun.l.google.com:19302
# Optional: base path when hosting under a sub-path (e.g. GitHub Pages /repo-name/)
# VITE_BASE=/skills-github-pages/
